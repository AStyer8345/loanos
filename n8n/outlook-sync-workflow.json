{
  "name": "LoanOS — Outlook Email Sync",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "d1e2f3a4-b5c6-7890-abcd-ef1234567890",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NETLIFY_SITE_URL }}/.netlify/functions/outlook-sync",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "a1b2c3d4-e5f6-7890-abcd-123456789012",
      "name": "Trigger Outlook Sync",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "outlook-sync-secret",
          "name": "LoanOS Sync Secret"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2c3d4e5-f6a7-8901-bcde-234567890123",
      "name": "Sync Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "jsCode": "const stats = $input.first().json.stats;\nconsole.log(`[outlook-sync] Inserted: ${stats.inserted}, Skipped: ${stats.skipped}, Unmatched: ${stats.unmatched}`);\nreturn $input.all();"
      },
      "id": "c3d4e5f6-a7b8-9012-cdef-345678901234",
      "name": "Log Stats",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 220]
    },
    {
      "parameters": {
        "jsCode": "const err = $input.first().json.error || 'Unknown error';\nconsole.error(`[outlook-sync] FAILED: ${err}`);\n// Optionally: send Slack/email alert here\nreturn $input.all();"
      },
      "id": "d4e5f6a7-b8c9-0123-defa-456789012345",
      "name": "Log Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 400]
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Trigger Outlook Sync",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Outlook Sync": {
      "main": [
        [
          {
            "node": "Sync Succeeded?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sync Succeeded?": {
      "main": [
        [
          {
            "node": "Log Stats",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "_readme": {
    "setup": [
      "1. Import this JSON into n8n via Workflows → Import from file",
      "2. Create an HTTP Header Auth credential named 'LoanOS Sync Secret'",
      "   Header Name: x-sync-secret",
      "   Header Value: <same value as OUTLOOK_SYNC_SECRET Netlify env var>",
      "3. Set n8n environment variable NETLIFY_SITE_URL to your Netlify URL (e.g. https://loanos.netlify.app)",
      "4. Activate the workflow"
    ]
  }
}
