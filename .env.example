# LoanOS — Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Project URL (from Supabase dashboard → Settings → API)
SUPABASE_URL=https://uuqedsvjlkeszrbwzizl.supabase.co

# Anon key — safe for browser, respects RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — server-side only, bypasses RLS. NEVER expose to browser.
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ─── n8n / Arive Integration ───────────────────────────────────────────────────
# n8n uses its own internal env vars (set via n8n dashboard → Settings → Variables).
# These are documented here for reference and used by scripts/test-webhooks.js.

# Your n8n instance webhook base URL (no trailing slash)
# Production:  https://styer.app.n8n.cloud/webhook
# Test mode:   https://styer.app.n8n.cloud/webhook-test
N8N_WEBHOOK_BASE_URL=https://styer.app.n8n.cloud/webhook

# Shared secret validated in n8n Webhook node (Header Auth credential)
# Generate with: openssl rand -hex 32
ARIVE_WEBHOOK_SECRET=your-webhook-secret-here

# ─── n8n Internal Variables (set in n8n dashboard, not .env.local) ─────────────
# The following vars must be configured inside n8n:
#
#   SUPABASE_URL          = https://uuqedsvjlkeszrbwzizl.supabase.co
#   SUPABASE_SERVICE_KEY  = your-service-role-key-here
#   LOANOS_SYSTEM_USER_ID = UUID of the LoanOS system user in auth.users
#
# To find LOANOS_SYSTEM_USER_ID:
#   SELECT id FROM auth.users ORDER BY created_at LIMIT 1;
#   (or use the Supabase dashboard → Authentication → Users)
LOANOS_SYSTEM_USER_ID=your-auth-user-uuid-here

# ─── Next.js App ───────────────────────────────────────────────────────────────
# Used by Next.js middleware and server-side Supabase client
NEXT_PUBLIC_SUPABASE_URL=https://uuqedsvjlkeszrbwzizl.supabase.co
