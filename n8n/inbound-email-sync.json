      "id": "update_last_touch",
      "name": "Update Contact last_touch_at",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1780, 160]
    },
    {
      "parameters": {
        "jsCode": "// Check if unmatched email looks transactional (mortgage-related)\nconst subject = ($input.item.json.subject || '').toLowerCase();\nconst body = ($input.item.json.body_snippet || '').toLowerCase();\nconst text = subject + ' ' + body;\n\n// Dollar amounts\nconst hasDollar = /\\$[\\d,]+(\\.\\d{2})?/.test(text);\n\n// Mortgage keywords\nconst mortgageKeywords = [\n  'loan', 'mortgage', 'closing', 'escrow', 'title',\n  'application', 'pre-approval', 'approval', 'preapproval',\n  'rate', 'lock', 'commitment', 'appraisal', 'underwriting',\n  'disclosure', 'settlement', 'deed', 'lien'\n];\nconst hasKeyword = mortgageKeywords.some(kw => text.includes(kw));\n\n// Street address pattern (number + street name)\nconst hasAddress = /\\d+\\s+[a-z]+\\s+(st|street|ave|avenue|blvd|boulevard|dr|drive|ln|lane|rd|road|ct|court|way|pl|place|cir|circle)/i.test(text);\n\nconst isTransactional = hasDollar || hasKeyword || hasAddress;\n\nif (isTransactional) {\n  return [{ json: { ...($input.item.json), is_transactional: true } }];\n}\n\n// Not transactional — stop, do not log\nreturn [];"
      },
      "id": "check_transactional",
      "name": "Is Transactional?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 440]
