# ─── Supabase ─────────────────────────────────────────────────────────────────
# Public keys (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-side only, never expose to browser
# Used by netlify/functions/arive-webhook.js to bypass RLS
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Arive Webhook ────────────────────────────────────────────────────────────
# Shared secret between Arive, n8n, and the Netlify function.
# Generate with: openssl rand -hex 32
ARIVE_WEBHOOK_SECRET=your-webhook-secret-here

# ─── LoanOS System User ───────────────────────────────────────────────────────
# The auth.users UUID for system-originated records (Arive sync, automation).
# Create a dedicated "system" user in Supabase Auth and paste the UUID here.
LOANOS_SYSTEM_USER_ID=your-system-user-uuid

# ─── Alert Routing (used by n8n arive-to-supabase workflow) ──────────────────
# Zapier webhook URL that accepts { to, subject, body } and sends via Outlook
ZAPIER_OUTLOOK_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your-hook-id/

# Email address that receives webhook failure alerts
LOANOS_ALERT_EMAIL=adam@styermortgage.com

# ─── Netlify (used by n8n workflow to call the function) ──────────────────────
# Production URL of the Netlify site (no trailing slash)
LOANOS_NETLIFY_URL=https://your-site.netlify.app
