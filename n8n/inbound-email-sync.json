    {
      "parameters": {
        "jsCode": "// Filter out noise: bulk mail, system notifications, lender auto-emails\n// Extend this list as needed. Goal is to ignore bulk/system mail.\n\nconst from = $input.item.json.from_address || '';\n\n// Block patterns in the local part (before @)\nconst blockedPrefixes = [\n  'noreply', 'no-reply', 'donotreply', 'do-not-reply',\n  'notifications', 'alerts', 'support', 'info', 'hello',\n  'mailer-daemon', 'postmaster'\n];\n\n// Block patterns in the domain\nconst blockedDomains = [\n  'mailchimp.com', 'constantcontact.com', 'hubspot.com',\n  'fanniemae.com', 'freddiemac.com', 'uhm.com',\n  'sendgrid.net', 'mailgun.org', 'amazonses.com',\n  'bounce.google.com', 'linkedin.com', 'facebookmail.com'\n];\n\nconst [localPart, domain] = from.split('@');\n\nconst isBlockedPrefix = blockedPrefixes.some(p => localPart?.startsWith(p));\nconst isBlockedDomain = blockedDomains.some(d => domain?.endsWith(d));\n\nif (isBlockedPrefix || isBlockedDomain) {\n  return []; // Drop — returns 0 items, stops workflow on this branch\n}\n\nreturn [$input.item];"
      },
      "id": "filter_noise",
      "name": "Filter Noise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300],
      "notes": "Extend blockedPrefixes and blockedDomains as needed. Goal is to ignore bulk/system mail."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://uuqedsvjlkeszrbwzizl.supabase.co/rest/v1/contacts",
        "sendQuery": true,
        "queryParameters": {
