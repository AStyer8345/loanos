      "id": "find_contact",
      "name": "Find Contact by Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 300],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Check if contact was found\n// n8n unwraps single-element arrays, so handle both cases\nconst result = $input.item.json;\nconst hasContact = result && result.id;\n\nconst extract = $('Extract Fields').first().json;\n\nif (hasContact) {\n  return [{\n    json: {\n      matched: true,\n      contact_id: result.id,\n      contact_type: result.contact_type || 'borrower',\n      full_name: `${result.first_name || ''} ${result.last_name || ''}`.trim(),\n      ...extract\n    }\n  }];\n} else {\n  return [{\n    json: {\n      matched: false,\n      contact_id: null,\n      contact_type: null,\n      ...extract\n    }\n  }];\n}"
      },
      "id": "check_contact",
      "name": "Check Contact Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "combinator": "and",
          "conditions": [
            {
              "id": "matched",
              "leftValue": "={{ $json.matched }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        }
      },
      "id": "if_contact_found",
      "name": "Contact Found?",
